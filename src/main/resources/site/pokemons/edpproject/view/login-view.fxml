<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="300.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="site.pokemons.edpproject.controller.LoginController">
   <children>
      <VBox layoutX="158.0" layoutY="85.0" prefHeight="126.0" prefWidth="183.0">
         <children>
            <Label fx:id="infoLabel" />
            <Label fx:id="usernameLb" text="Nazwa użytkownika" />
            <TextField fx:id="usernameText" />
            <Label fx:id="passwdLb" text="Hasło" />
            <TextField fx:id="passwdText" />
            <Button fx:id="registerButton" mnemonicParsing="false" onMouseClicked="#loginHandle" text="Zaloguj" />
         </children>
      </VBox>
   </children>
</AnchorPane>
