<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="570.0" prefWidth="900.0" stylesheets="@../../../../styles/loginStyle.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="site.pokemons.edpproject.controller.LoginController">
   <children>
      <VBox layoutX="339.0" layoutY="162.0" prefHeight="246.0" prefWidth="222.0" styleClass="vbox">
         <children>
            <Label fx:id="infoLabel" />
            <Label fx:id="usernameLb" text="Nazwa użytkownika" />
            <TextField fx:id="usernameText" />
            <Label fx:id="passwdLb" text="Hasło" />
            <PasswordField fx:id="passwdText" />
            <Button fx:id="registerButton" mnemonicParsing="false" onMouseClicked="#loginHandle" styleClass="login-button" text="Zaloguj" />
            <Label onMouseClicked="#registerLoadHandle" text="Przejdź do rejestracji" />
         </children>
      </VBox>
   </children>
</AnchorPane>
