<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root alignment="CENTER_LEFT" prefHeight="333.0" prefWidth="355.0" spacing="15" styleClass="reservation-summary" type="HBox" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1">

    <ImageView fx:id="posterImage" fitHeight="333.0" fitWidth="113.0" />

    <VBox spacing="5" styleClass="reservation-summary">
        <Label fx:id="movieTitle" />
        <Label fx:id="screeningTime" />
        <Label fx:id="seatsInfo" />
        <Button fx:id="endButton" prefHeight="32.0" prefWidth="162.0" styleClass="summary-button" text="Dzisiejszy repertuar" />
    </VBox>
</fx:root>
