<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.image.ImageView?>
<HBox alignment="TOP_LEFT" maxWidth="900" spacing="10" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="site.pokemons.edpproject.controller.MovieListCellController">
   <children>
       <ImageView fx:id="image" fitHeight="200" preserveRatio="true" smooth="true" />

      <VBox spacing="5" maxWidth="600">
         <children>
            <Label fx:id="titleLabel" style="-fx-font-weight: bold; -fx-font-size: 16px;" wrapText="true" />
            <Label fx:id="overviewLabel" wrapText="true" />
         </children>
      </VBox>

      <VBox spacing="5" maxWidth="160">
         <children>
            <TextField fx:id="priceField" promptText="Cena" />
            <TextField fx:id="hallField" promptText="Sala" />
            <DatePicker fx:id="datePicker" promptText="Data" />
         </children>
      </VBox>

      <VBox spacing="5" maxWidth="160">
         <children>
            <Label text="Godzina" />
            <Spinner fx:id="hourSpinner" />
            <Label text="Minuta" />
            <Spinner fx:id="minuteSpinner" />
            <Button fx:id="saveButton" text="Zapisz w repertuarze" maxWidth="Infinity" />
         </children>
      </VBox>
   </children>
</HBox>

